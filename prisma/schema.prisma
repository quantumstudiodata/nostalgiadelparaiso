// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Default output (node_modules/@prisma/client) on purpose: Vercel's
// serverless function bundler has first-class, well-tested support for
// that location. A custom `output` path repeatedly failed to ship the
// query-engine binary into the deployed function despite matching
// binaryTargets and explicit output-file-tracing includes.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ADMIN/EDITOR manage the whole site; AUTHOR can only write posts;
// READER is a registered reader (can comment, gets new-post emails).
enum Role {
  ADMIN
  EDITOR
  AUTHOR
  READER
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  avatarUrl    String?
  bio          String?
  // Public writer profile (Escritores): cover image and an external link.
  coverUrl     String?
  websiteUrl   String?
  // Personal social links shown on the writer profile: { instagram, facebook, tiktok }.
  socialLinks  Json?
  // Null until the person confirms the code sent to their email.
  emailVerified DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts    Post[]
  comments Comment[]
}

// Public writer profiles (Escritores), created in the panel. Not accounts.
model Writer {
  id        String   @id @default(cuid())
  name      String
  avatarUrl String?
  coverUrl  String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
}

// One-time codes sent by email: sign-up confirmation, password reset, email change.
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  purpose   String // "register" | "reset" | "email-change"
  codeHash  String
  data      Json?
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  order Int    @default(0)

  // Content shown on the homepage's "leer entradas" card for this
  // category and on the category's own listing page. Editable from
  // /admin/categorias; the taxonomy itself (add/remove/reorder
  // categories) stays a code change.
  cardTitle   String?
  description String?
  imageUrl    String?
  // Listed in "En este ecosistema conviven" and "Talleres y voces de la comunidad".
  inEcosystem Boolean @default(true)

  posts Post[]
}

model Post {
  id         String     @id @default(cuid())
  title      String
  slug       String     @unique
  excerpt    String?
  content    String
  coverImage String?
  status     PostStatus @default(DRAFT)
  likes      Int        @default(0)
  publishedAt DateTime?
  // When subscribers were emailed about it; set once, on first publish.
  announcedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Account that created the post (for permissions).
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])

  // Public writer profile shown as the post's author.
  writerId   String
  writer     Writer    @relation(fields: [writerId], references: [id])

  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])

  comments Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  // 1–5 stars, optional.
  rating    Int?
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Signed-in commenters link their account; guests leave a name and a private email.
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorName  String?
  authorEmail String?

  @@index([postId, createdAt])
}

// People who get an email when a new post is published.
model Subscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  unsubscribeToken String   @unique @default(cuid())
  // Double opt-in: emails go only to confirmed subscribers.
  verified         Boolean  @default(false)
  confirmToken     String?  @unique
  createdAt        DateTime @default(now())
}

// One row per page view, for the Estadísticas page.
model PageView {
  id        String   @id @default(cuid())
  path      String
  postId    String?
  source    String // "google" | "instagram" | "facebook" | "tiktok" | "anuncios" | "directo" | "otros"
  visitorId String
  sessionId String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([postId])
}

// Bell in the admin panel: sign-ups, subscribers, comments, likes, messages.
model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// Messages sent through "Escríbenos".
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

// Fixed, structural sections of the public site (hero, about, etc).
// Editors can change the `fields` (JSON: text/image values) but never
// add, remove or reorder blocks — that requires a code change.
model SiteBlock {
  id     String @id // stable key, e.g. "home.hero", "about.intro"
  page   String // "home" | "about" | ...
  label  String // human-readable name shown in the admin panel
  fields Json // { "title": "...", "body": "...", "buttonText": "...", "imageUrl": "..." }

  updatedAt DateTime @updatedAt
}
